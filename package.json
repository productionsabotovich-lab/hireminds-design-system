{
  "name": "@hireminds/design-system",
  "version": "0.11.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/productionsabotovich-lab/hireminds-design-system.git"
  },
  "description": "Hireminds design system «B2 · Frost Graphite»: tokens, base styles and UI components.",
  "exports": {
    "./components": "./components/index.ts",
    "./tokens/tokens.css": "./tokens/tokens.css",
    "./styles/base.css": "./styles/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "tokens",
    "styles",
    "fonts"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:types": "node scripts/build-types.mjs",
    "build": "npm run build:tokens && npm run build:bundle && npm run build:types",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/render-check.mjs",
    "pack:artifact": "node scripts/pack-artifact.mjs",
    "pack:page": "node scripts/pack-page.mjs",
    "check:version": "node scripts/check-version.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "typescript": "5.9.3"
  }
}
